<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="12dp"
    android:layout_marginEnd="12dp"
    android:layout_marginTop="12dp"
    android:layout_marginBottom="12dp"
    android:background="@drawable/app_surface_card"
    android:orientation="vertical"
    android:padding="18dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/system_dark_mode_title"
        android:textColor="@color/app_text_primary"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/system_dark_mode_summary"
        android:textColor="@color/app_text_secondary"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/system_dark_mode_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:textColor="@color/app_accent_soft"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/system_dark_mode_device"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="@color/app_text_secondary"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/system_dark_mode_instructions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:textColor="@color/app_text_secondary"
        android:textSize="13sp" />

    <Button
        android:id="@+id/system_dark_mode_configure"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:backgroundTint="@color/app_accent"
        android:text="@string/system_dark_mode_configure"
        android:textAllCaps="false"
        android:textColor="@android:color/white" />

</LinearLayout>
